{
  "name": "lis-journey-tests",
  "version": "0.0.1",
  "description": "E2E Journey tests for LIS Front and Back Office services",
  "engines": {
    "node": ">=24.13.0"
  },
  "keywords": [
    "e2e",
    "playwright",
    "testautomation",
    "uat"
  ],
  "homepage": "https://github.com/DEFRA/lis-journey-tests#README.md",
  "bugs": {
    "url": "https://github.com/DEFRA/lis-journey-tests/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DEFRA/lis-journey-tests.git"
  },
  "license": "OGL-UK-3.0",
  "author": "Ransom Voke Anighoro",
  "scripts": {
    "clean": "rimraf dist allure-results allure-report playwright-report test-results",
    "format": "prettier --write \"tests/**/*.ts\" \"**/*.{ts,md,json,config.ts}\"",
    "format:check": "prettier --check \"tests/**/*.ts\" \"**/*.{ts,md,json,config.ts}\"",
    "git:pre-commit-hook": "npm run format:check && npm run lint",
    "lint": "eslint \"tests/**/*.ts\" \"playwright.config.ts\"",
    "lint:fix": "eslint \"tests/**/*.ts\" \"playwright.config.ts\" --fix",
    "merge:report": "npx ctrf merge playwright-report/",
    "prepare": "husky",
    "test": "npm run test:playwright",
    "test:playwright": "npx playwright install && npm run clean && npx bddgen && npx playwright test --config=playwright.config.ts",
    "report": "allure generate allure-results --single-file --clean",
    "report:publish": "npm run report; ./bin/publish-tests.sh"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "commitlint": "21.2.4",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "allure-commandline": "2.46.1",
    "allure-playwright": "3.13.0",
    "axe": "14.0.0",
    "dotenv": "18.0.8",
    "http-status-codes": "2.3.0",
    "playwright": "1.64.1",
    "playwright-bdd": "9.2.1",
    "playwright-ctrf-json-reporter": "0.1.0",
    "rimraf": "6.1.3",
    "uuid": "14.0.3"
  }
}
