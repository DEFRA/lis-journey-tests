LIS_FRONTOFFICE_BASE_URL=https://lis-hubs-front-office.dev.cdp-int.defra.cloud/
LIS_BACKOFFICE_BASE_URL=
LIS_FRONTOFFICE_USER_SINGLECPH_EMAIL=
LIS_FRONTOFFICE_USER_SINGLECPH_PASSWORD=
LIS_FRONTOFFICE_USER_NOCPH_EMAIL=
LIS_FRONTOFFICE_USER_NOCPH_PASSWORD=
LIS_FRONTOFFICE_USER_MULTIPLECPH_EMAIL=
